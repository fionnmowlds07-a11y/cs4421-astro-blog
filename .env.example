# Copy this file to .env and fill in real values. .env is gitignored; never commit secrets.
# Secrets are read at runtime, not build time:
#   node --env-file=.env dist/server/entry.mjs
#   docker compose up            (loads .env via env_file)
#   docker run --env-file .env -p 4321:4321 astro-blog:local

# Free API key from https://www.football-data.org/client/register (used by the Man United page)
FOOTBALL_DATA_API_KEY=

# Supabase for the rowing section (see docs/adr/ADR-002). Use the PUBLISHABLE key only, never the secret/service_role key.
# Local development: run `npm run db:start`, then copy API_URL and PUBLISHABLE_KEY from `npm run db:status`.
# Live project: Supabase dashboard > Project Settings > API keys.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
