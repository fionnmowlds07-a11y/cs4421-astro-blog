---
// My 2k split over time, one line per machine, as a server-rendered SVG chart (geometry in src/lib/split-chart.ts).
// Like PositionChart: a crosshair snaps to the nearest date (pointer and arrow keys), the tooltip lists every
// machine with a 2k that day, and the same numbers are always in the table underneath.
// Series colours are validated categorical slots 1 and 2 (blue, orange) and follow the machine, never its rank.
import type { TwoKPoint } from '../../lib/rowing-data';
import { formatDate, MACHINE_NAMES } from '../../lib/rowing-format';
import { formatTime } from '../../lib/rowing-time';
import { buildSplitChart } from '../../lib/split-chart';

interface Props {
	points: TwoKPoint[];
	width: number;
	height: number;
	class?: string;
}

const { points, width, height, class: className } = Astro.props;
const chart = buildSplitChart(points, width, height);
const { pad } = chart;
const COLORS = { concept2: 'var(--series-1)', rp3: 'var(--series-2)' } as const;
// End labels need to fit beside the line on a phone, so the narrow chart uses short names (the legend has the full ones).
const SHORT_NAMES = { concept2: 'C2', rp3: 'RP3' } as const;
const narrow = width < 500;

const lines = chart.lines.map((line) => ({ ...line, label: MACHINE_NAMES[line.machine], color: COLORS[line.machine] }));
const ends = lines.map((line) => ({ ...line, end: line.points[line.points.length - 1] }));
// Direct end labels only when they can't collide; otherwise the legend and tooltip carry identity.
const labelEnds = ends.every((a, i) =>
	ends.every((b, j) => i === j || Math.abs(a.end.y - b.end.y) >= 16 || Math.abs(a.end.x - b.end.x) >= 70),
);

const describe = (date: string) => {
	const parts = lines.flatMap((line) =>
		line.points.filter((p) => p.date === date).map((p) => `${line.label} ${formatTime(p.split)} per 500 m`),
	);
	return `${formatDate(date)}: ${parts.join(', ')}`;
};
const lastDate = chart.dates[chart.dates.length - 1].date;
const chartData = JSON.stringify({
	dates: chart.dates.map((d) => ({ date: d.date, label: formatDate(d.date), x: d.x / width })),
	lines: lines.map((line) => ({
		label: line.label,
		color: line.color,
		points: line.points.map((p) => ({ date: p.date, x: p.x, y: p.y, split: formatTime(p.split), test: p.isTest })),
	})),
});
const rows = lines
	.flatMap((line) => line.points.map((p) => ({ ...p, label: line.label })))
	.sort((a, b) => b.date.localeCompare(a.date));
---

<figure class:list={['split-chart', className]}>
	{
		lines.length > 1 && (
			<ul class="legend">
				{lines.map((line) => (
					<li>
						<span class="key" style={`background: ${line.color}`} aria-hidden="true" />
						{line.label}
					</li>
				))}
			</ul>
		)
	}
	<div
		class="plot"
		role="slider"
		tabindex="0"
		aria-label="2k split by date. Use the arrow keys to move between dates."
		aria-valuemin={1}
		aria-valuemax={chart.dates.length}
		aria-valuenow={chart.dates.length}
		aria-valuetext={describe(lastDate)}
		data-split-chart={chartData}
	>
		<svg viewBox={`0 0 ${width} ${height}`} width="100%" aria-hidden="true">
			<g class="grid">
				{
					chart.yTicks.map((t) => (
						<>
							<line x1={pad.left} x2={width - pad.right} y1={t.y} y2={t.y} />
							<text x={pad.left - 8} y={t.y} text-anchor="end" dominant-baseline="middle">
								{t.label}
							</text>
						</>
					))
				}
				{
					chart.xTicks.map((t) => (
						<text x={t.x} y={height - pad.bottom + 18} text-anchor="middle">
							{t.label}
						</text>
					))
				}
				<text class="axis-title" x="0" y="10">Split /500m (faster ↑)</text>
			</g>
			<line class="crosshair" x1="0" x2="0" y1={pad.top} y2={height - pad.bottom} />
			{
				lines.map((line) => (
					<polyline
						class="line"
						points={line.points.map((p) => `${p.x},${p.y}`).join(' ')}
						style={`stroke: ${line.color}`}
					/>
				))
			}
			{
				lines.map((line) =>
					line.points.map((p) => <circle class="dot" cx={p.x} cy={p.y} r="4" style={`fill: ${line.color}`} />),
				)
			}
			{
				labelEnds &&
					ends.map((line) => (
						<text class="end-label" x={line.end.x + 10} y={line.end.y} dominant-baseline="middle">
							{narrow ? SHORT_NAMES[line.machine] : line.label} {formatTime(line.end.split)}
						</text>
					))
			}
			{lines.map((line) => <circle class="hover-dot" r="5" style={`fill: ${line.color}`} />)}
		</svg>
		<div class="tooltip" role="presentation"></div>
	</div>
	<details class="table-view">
		<summary>Show as a table</summary>
		<table>
			<thead>
				<tr>
					<th scope="col">Date</th>
					<th scope="col">Machine</th>
					<th scope="col">Time</th>
					<th scope="col">Split</th>
				</tr>
			</thead>
			<tbody>
				{
					rows.map((r) => (
						<tr>
							<th scope="row">{formatDate(r.date)}</th>
							<td>{r.label}</td>
							<td>
								{formatTime(r.time)}
								{r.isTest && ' (test)'}
							</td>
							<td>{formatTime(r.split)}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</details>
</figure>

<script>
	interface ChartData {
		dates: { date: string; label: string; x: number }[];
		lines: { label: string; color: string; points: { date: string; x: number; y: number; split: string; test: boolean }[] }[];
	}

	function setup(plot: HTMLElement) {
		plot.dataset.ready = '';
		const data = JSON.parse(plot.dataset.splitChart ?? '{}') as ChartData;
		const svg = plot.querySelector('svg');
		const tooltip = plot.querySelector<HTMLElement>('.tooltip');
		const crosshair = plot.querySelector<SVGLineElement>('.crosshair');
		const dots = [...plot.querySelectorAll<SVGCircleElement>('.hover-dot')];
		if (!svg || !tooltip || !crosshair || data.dates.length === 0) return;
		const viewWidth = svg.viewBox.baseVal.width;
		let index = data.dates.length - 1;

		function show(i: number) {
			index = Math.max(0, Math.min(data.dates.length - 1, i));
			const { date, label, x } = data.dates[index];
			crosshair!.setAttribute('x1', String(x * viewWidth));
			crosshair!.setAttribute('x2', String(x * viewWidth));

			// Only the machines with a 2k on this date get a dot and a row.
			const heading = document.createElement('p');
			heading.className = 'tooltip-title';
			heading.textContent = label;
			const rows: HTMLElement[] = [];
			const spoken: string[] = [];
			data.lines.forEach((line, s) => {
				const point = line.points.find((p) => p.date === date);
				dots[s].style.visibility = point ? 'visible' : 'hidden';
				if (!point) return;
				dots[s].setAttribute('cx', String(point.x));
				dots[s].setAttribute('cy', String(point.y));
				const row = document.createElement('p');
				const key = document.createElement('span');
				key.className = 'tooltip-key';
				key.style.background = line.color;
				const value = document.createElement('strong');
				value.textContent = point.split;
				row.append(key, value, ` ${line.label}${point.test ? ' (test)' : ''}`);
				rows.push(row);
				spoken.push(`${line.label} ${point.split} per 500 m`);
			});
			tooltip!.replaceChildren(heading, ...rows);

			// Keep the tooltip inside the chart: flip to the left of the crosshair past the middle.
			tooltip!.style.left = `${x * plot.clientWidth}px`;
			tooltip!.classList.toggle('flip', x > 0.55);
			plot.classList.add('active');
			plot.setAttribute('aria-valuenow', String(index + 1));
			plot.setAttribute('aria-valuetext', `${label}: ${spoken.join(', ')}`);
		}

		const hide = () => plot.classList.remove('active');

		// The crosshair snaps to the nearest date, so the pointer never has to land on a line.
		plot.addEventListener('pointermove', (event) => {
			const box = svg.getBoundingClientRect();
			const fraction = (event.clientX - box.left) / box.width;
			let nearest = 0;
			data.dates.forEach((d, i) => {
				if (Math.abs(d.x - fraction) < Math.abs(data.dates[nearest].x - fraction)) nearest = i;
			});
			show(nearest);
		});
		plot.addEventListener('pointerleave', () => {
			if (document.activeElement !== plot) hide();
		});
		plot.addEventListener('focus', () => show(index));
		plot.addEventListener('blur', hide);
		plot.addEventListener('keydown', (event) => {
			const moves: Record<string, number> = {
				ArrowLeft: index - 1,
				ArrowDown: index - 1,
				ArrowRight: index + 1,
				ArrowUp: index + 1,
				Home: 0,
				End: data.dates.length - 1,
			};
			if (event.key in moves) {
				event.preventDefault();
				show(moves[event.key]);
			}
		});
	}

	// This inline script can run after the router's first astro:page-load has already fired,
	// so set up now and again after every View Transitions navigation (each chart only once).
	const init = () => document.querySelectorAll<HTMLElement>('[data-split-chart]:not([data-ready])').forEach(setup);
	init();
	document.addEventListener('astro:page-load', init);
</script>

<style>
	.split-chart {
		/* Categorical slots 1 and 2 from the validated reference palette (checked against the white surface). */
		--series-1: #2a78d6;
		--series-2: #eb6834;
		margin: 0;
	}
	.legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		margin: 0 0 0.75rem;
		padding: 0;
		list-style: none;
		font-size: 0.75em;
		font-weight: 700;
		color: rgb(var(--gray-dark));
	}
	.legend li {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	/* Line keys mirror the marks: a short stroke, not a box */
	.key {
		width: 1rem;
		height: 3px;
		border-radius: 2px;
	}
	.plot {
		position: relative;
		border-radius: 8px;
		touch-action: pan-y;
	}
	svg {
		display: block;
		overflow: visible;
	}
	.grid line {
		stroke: rgba(var(--gray-light), 100%);
		stroke-width: 1;
	}
	.grid text,
	.end-label {
		font-size: 12px;
		fill: rgb(var(--gray));
		font-variant-numeric: tabular-nums;
	}
	.end-label {
		fill: rgb(var(--gray-dark));
		font-weight: 700;
	}
	.axis-title {
		font-size: 11px;
	}
	.line {
		fill: none;
		stroke-width: 2;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	/* 8px dots with a 2px ring in the surface colour, so they stay clear where lines cross */
	.dot,
	.hover-dot {
		stroke: var(--surface);
		stroke-width: 2;
	}
	.crosshair {
		stroke: rgb(var(--gray));
		stroke-width: 1;
		opacity: 0;
	}
	.hover-dot,
	.tooltip {
		opacity: 0;
		pointer-events: none;
		transition: opacity var(--speed) var(--ease);
	}
	.plot.active .crosshair,
	.plot.active .hover-dot,
	.plot.active .tooltip {
		opacity: 1;
	}
	.plot:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
	}
	.tooltip {
		position: absolute;
		top: 0;
		z-index: 2;
		min-width: 8rem;
		margin-left: 12px;
		padding: 0.5rem 0.75rem;
		border-radius: 8px;
		background: var(--surface);
		box-shadow: 0 4px 16px rgba(var(--black), 16%);
		font-size: 0.7em;
		line-height: 1.5;
		white-space: nowrap;
	}
	.tooltip.flip {
		margin-left: 0;
		transform: translateX(calc(-100% - 12px));
	}
	.tooltip :global(p) {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin: 0;
		color: rgb(var(--gray));
	}
	.tooltip :global(.tooltip-title) {
		font-weight: 700;
		color: rgb(var(--gray-dark));
	}
	.tooltip :global(strong) {
		color: rgb(var(--black));
	}
	.tooltip :global(.tooltip-key) {
		display: inline-block;
		width: 0.8rem;
		height: 3px;
		border-radius: 2px;
	}
	.table-view {
		margin-top: 0.75rem;
		font-size: 0.75em;
	}
	.table-view summary {
		cursor: pointer;
		color: var(--accent);
	}
	.table-view table {
		margin-top: 0.5rem;
		border-collapse: collapse;
		font-variant-numeric: tabular-nums;
	}
	.table-view th,
	.table-view td {
		padding: 0.25rem 0.75rem 0.25rem 0;
		text-align: left;
		white-space: nowrap;
	}
	@media (prefers-reduced-motion: reduce) {
		.hover-dot,
		.tooltip {
			transition: none;
		}
	}
</style>
