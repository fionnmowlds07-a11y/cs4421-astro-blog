---
// The look of the Log in / Admin link on the Rowing page. Shared by AdminLink (the server island)
// and the page's fallback, so both look the same before and after the island loads.
import { ADMIN_PATH, LOGIN_PATH } from '../../lib/admin-guard';

interface Props {
	loggedIn: boolean;
}

const { loggedIn } = Astro.props;
---

<a class:list={['admin-link', { 'is-admin': loggedIn }]} href={loggedIn ? ADMIN_PATH : LOGIN_PATH} data-testid="admin-link">
	{
		loggedIn ? (
			<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
				<path
					fill="currentColor"
					d="M12.15 1.15a.5.5 0 0 1 .7 0l2 2a.5.5 0 0 1 0 .7l-9 9a.5.5 0 0 1-.22.13l-3.5 1a.5.5 0 0 1-.62-.62l1-3.5a.5.5 0 0 1 .13-.22l9-9zM11.5 3.2 4.06 10.65l-.55 1.84 1.84-.55L12.8 4.5l-1.3-1.3z"
				/>
			</svg>
		) : (
			<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
				<path
					fill="currentColor"
					d="M8 1a3 3 0 0 0-3 3v2H4a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1h-1V4a3 3 0 0 0-3-3zM6 6V4a2 2 0 1 1 4 0v2H6z"
				/>
			</svg>
		)
	}
	{loggedIn ? 'Admin' : 'Log in'}
</a>

<style>
	.admin-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.45rem 0.9rem;
		border: 1px solid rgba(var(--gray-light), 100%);
		border-radius: 999px;
		background: var(--surface);
		box-shadow: 0 1px 2px rgba(var(--black), 6%);
		color: rgb(var(--gray-dark));
		font-size: 0.85rem;
		font-weight: 700;
		text-decoration: none;
		transition:
			border-color var(--speed) var(--ease),
			color var(--speed) var(--ease),
			background var(--speed) var(--ease);
	}
	.admin-link:hover,
	.admin-link:focus-visible {
		border-color: var(--accent);
		color: var(--accent);
	}
	.admin-link.is-admin {
		border-color: var(--accent);
		background: var(--accent);
		color: #ffffff;
	}
	.admin-link.is-admin:hover,
	.admin-link.is-admin:focus-visible {
		border-color: var(--accent-dark);
		background: var(--accent-dark);
		color: #ffffff;
	}
</style>
