---
// League position after each matchday for a few teams, as a server-rendered SVG line chart.
// Position 1 is at the top. A small script adds a crosshair tooltip (pointer and arrow keys);
// the same numbers are always available in the table underneath, so nothing depends on hovering.

export interface ChartSeries {
	label: string;
	short: string;
	/** A CSS colour for the line and dot (never used for text). */
	color: string;
	positions: number[];
}

interface Props {
	matchdays: number[];
	series: ChartSeries[];
	teamCount: number;
	width: number;
	height: number;
	class?: string;
}

const { matchdays, series, teamCount, width, height, class: className } = Astro.props;

const pad = { left: 30, right: width < 500 ? 58 : 76, top: 12, bottom: 34 };
const plotWidth = width - pad.left - pad.right;
const plotHeight = height - pad.top - pad.bottom;
const xs = matchdays.map((_, i) => pad.left + (matchdays.length > 1 ? (i * plotWidth) / (matchdays.length - 1) : plotWidth / 2));
const y = (position: number) => pad.top + ((position - 1) * plotHeight) / Math.max(teamCount - 1, 1);

const yTicks = [1, 5, 10, 15, 20].filter((t) => t <= teamCount);
// Every matchday early in the season; every fifth once labels would crowd.
const step = matchdays.length <= (width < 500 ? 8 : 14) ? 1 : 5;
const xTicks = matchdays.map((m, i) => ({ m, x: xs[i] })).filter(({ m }, i) => i === 0 || m % step === 0);

const ordinal = (n: number) => {
	const suffix = n % 100 >= 11 && n % 100 <= 13 ? 'th' : ({ 1: 'st', 2: 'nd', 3: 'rd' } as Record<number, string>)[n % 10] ?? 'th';
	return `${n}${suffix}`;
};

const last = matchdays.length - 1;
const ends = series.map((s) => ({ ...s, y: y(s.positions[last]) }));
// Direct end labels only when they can't collide; otherwise the legend and tooltip carry identity.
const labelEnds = ends.every((a, i) => ends.every((b, j) => i === j || Math.abs(a.y - b.y) >= 16));

const describe = (i: number) =>
	`Matchday ${matchdays[i]}: ${series.map((s) => `${s.label} ${ordinal(s.positions[i])}`).join(', ')}`;
const chartData = JSON.stringify({
	xs: xs.map((x) => x / width),
	matchdays,
	series: series.map((s) => ({ label: s.label, color: s.color, positions: s.positions })),
});
---

<figure class:list={['position-chart', className]}>
	<ul class="legend">
		{
			series.map((s) => (
				<li>
					<span class="key" style={`background: ${s.color}`} aria-hidden="true" />
					{s.label}
				</li>
			))
		}
	</ul>
	<div
		class="plot"
		role="slider"
		tabindex="0"
		aria-label="League position by matchday. Use the arrow keys to move between matchdays."
		aria-valuemin={matchdays[0]}
		aria-valuemax={matchdays[last]}
		aria-valuenow={matchdays[last]}
		aria-valuetext={describe(last)}
		data-position-chart={chartData}
	>
		<svg viewBox={`0 0 ${width} ${height}`} width="100%" aria-hidden="true">
			<g class="grid">
				{
					yTicks.map((t) => (
						<>
							<line x1={pad.left} x2={width - pad.right} y1={y(t)} y2={y(t)} />
							<text x={pad.left - 8} y={y(t)} text-anchor="end" dominant-baseline="middle">
								{t}
							</text>
						</>
					))
				}
				{
					xTicks.map(({ m, x }) => (
						<text x={x} y={height - pad.bottom + 18} text-anchor="middle">
							{m}
						</text>
					))
				}
				<text class="axis-title" x={pad.left} y={height - 2}>Matchday</text>
			</g>
			<line class="crosshair" x1="0" x2="0" y1={pad.top} y2={height - pad.bottom} />
			{
				series.map((s) => (
					<polyline
						class="line"
						points={s.positions.map((p, i) => `${xs[i]},${y(p)}`).join(' ')}
						style={`stroke: ${s.color}`}
					/>
				))
			}
			{
				ends.map((s) => (
					<circle class="end" cx={xs[last]} cy={s.y} r="4" style={`fill: ${s.color}`} />
				))
			}
			{
				labelEnds &&
					ends.map((s) => (
						<text class="end-label" x={xs[last] + 10} y={s.y} dominant-baseline="middle">
							{s.short} {ordinal(s.positions[last])}
						</text>
					))
			}
			{series.map((s) => <circle class="hover-dot" r="4" style={`fill: ${s.color}`} />)}
		</svg>
		<div class="tooltip" role="presentation"></div>
	</div>
	<details class="table-view">
		<summary>Show as a table</summary>
		<div class="table-scroll">
			<table>
				<thead>
					<tr>
						<th scope="col">Matchday</th>
						{series.map((s) => <th scope="col">{s.label}</th>)}
					</tr>
				</thead>
				<tbody>
					{
						matchdays.map((m, i) => (
							<tr>
								<th scope="row">{m}</th>
								{series.map((s) => (
									<td>{ordinal(s.positions[i])}</td>
								))}
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</details>
</figure>

<script>
	interface ChartData {
		xs: number[];
		matchdays: number[];
		series: { label: string; color: string; positions: number[] }[];
	}

	const ordinal = (n: number) => {
		const suffix = n % 100 >= 11 && n % 100 <= 13 ? 'th' : ({ 1: 'st', 2: 'nd', 3: 'rd' } as Record<number, string>)[n % 10] ?? 'th';
		return `${n}${suffix}`;
	};

	function setup(plot: HTMLElement) {
		plot.dataset.ready = '';
		const data = JSON.parse(plot.dataset.positionChart ?? '{}') as ChartData;
		const svg = plot.querySelector('svg');
		const tooltip = plot.querySelector<HTMLElement>('.tooltip');
		const crosshair = plot.querySelector<SVGLineElement>('.crosshair');
		const dots = [...plot.querySelectorAll<SVGCircleElement>('.hover-dot')];
		const lines = [...plot.querySelectorAll<SVGPolylineElement>('.line')];
		if (!svg || !tooltip || !crosshair || data.xs.length === 0) return;
		const viewWidth = svg.viewBox.baseVal.width;
		let index = data.xs.length - 1;

		function show(i: number) {
			index = Math.max(0, Math.min(data.xs.length - 1, i));
			const x = data.xs[index] * viewWidth;
			crosshair!.setAttribute('x1', String(x));
			crosshair!.setAttribute('x2', String(x));
			dots.forEach((dot, s) => {
				const point = lines[s].points.getItem(index);
				dot.setAttribute('cx', String(point.x));
				dot.setAttribute('cy', String(point.y));
			});

			// Labels come from API data, so the tooltip is built with textContent, never innerHTML.
			const heading = document.createElement('p');
			heading.className = 'tooltip-title';
			heading.textContent = `Matchday ${data.matchdays[index]}`;
			const rows = data.series.map((s) => {
				const row = document.createElement('p');
				const key = document.createElement('span');
				key.className = 'tooltip-key';
				key.style.background = s.color;
				const value = document.createElement('strong');
				value.textContent = ordinal(s.positions[index]);
				row.append(key, value, ` ${s.label}`);
				return row;
			});
			tooltip!.replaceChildren(heading, ...rows);

			// Keep the tooltip inside the chart: flip to the left of the crosshair past the middle.
			const left = data.xs[index] * plot.clientWidth;
			tooltip!.style.left = `${left}px`;
			tooltip!.classList.toggle('flip', data.xs[index] > 0.55);
			plot.classList.add('active');
			plot.setAttribute('aria-valuenow', String(data.matchdays[index]));
			plot.setAttribute(
				'aria-valuetext',
				`Matchday ${data.matchdays[index]}: ${data.series.map((s) => `${s.label} ${ordinal(s.positions[index])}`).join(', ')}`,
			);
		}

		const hide = () => plot.classList.remove('active');

		// The crosshair snaps to the nearest matchday, so the pointer never has to land on a line.
		plot.addEventListener('pointermove', (event) => {
			const box = svg.getBoundingClientRect();
			const fraction = (event.clientX - box.left) / box.width;
			let nearest = 0;
			data.xs.forEach((x, i) => {
				if (Math.abs(x - fraction) < Math.abs(data.xs[nearest] - fraction)) nearest = i;
			});
			show(nearest);
		});
		plot.addEventListener('pointerleave', () => {
			if (document.activeElement !== plot) hide();
		});
		plot.addEventListener('focus', () => show(index));
		plot.addEventListener('blur', hide);
		plot.addEventListener('keydown', (event) => {
			const moves: Record<string, number> = {
				ArrowLeft: index - 1,
				ArrowDown: index - 1,
				ArrowRight: index + 1,
				ArrowUp: index + 1,
				Home: 0,
				End: data.xs.length - 1,
			};
			if (event.key in moves) {
				event.preventDefault();
				show(moves[event.key]);
			}
		});
	}

	// This inline script can run after the router's first astro:page-load has already fired,
	// so set up now and again after every View Transitions navigation (each chart only once).
	const init = () => document.querySelectorAll<HTMLElement>('[data-position-chart]:not([data-ready])').forEach(setup);
	init();
	document.addEventListener('astro:page-load', init);
</script>

<style>
	.position-chart {
		margin: 0;
	}
	.legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		margin: 0 0 0.75rem;
		padding: 0;
		list-style: none;
		font-size: 0.75em;
		font-weight: 700;
		color: rgb(var(--gray-dark));
	}
	.legend li {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	/* Line keys mirror the marks: a short 2px-tall stroke, not a box */
	.key {
		width: 1rem;
		height: 3px;
		border-radius: 2px;
	}
	.plot {
		position: relative;
		border-radius: 8px;
		touch-action: pan-y;
	}
	svg {
		display: block;
		overflow: visible;
	}
	.grid line {
		stroke: rgba(var(--gray-light), 100%);
		stroke-width: 1;
	}
	.grid text,
	.end-label {
		font-size: 12px;
		fill: rgb(var(--gray));
		font-variant-numeric: tabular-nums;
	}
	.end-label {
		fill: rgb(var(--gray-dark));
		font-weight: 700;
	}
	.axis-title {
		font-size: 11px;
	}
	.line {
		fill: none;
		stroke-width: 2;
		stroke-linejoin: round;
		stroke-linecap: round;
	}
	/* End and hover dots: 8px, with a 2px ring in the surface colour so they stay clear where lines cross */
	.end,
	.hover-dot {
		stroke: var(--surface);
		stroke-width: 2;
	}
	.crosshair {
		stroke: rgb(var(--gray));
		stroke-width: 1;
		opacity: 0;
	}
	.hover-dot,
	.tooltip {
		opacity: 0;
		pointer-events: none;
		transition: opacity var(--speed) var(--ease);
	}
	.plot.active .crosshair,
	.plot.active .hover-dot,
	.plot.active .tooltip {
		opacity: 1;
	}
	.tooltip {
		position: absolute;
		top: 0;
		z-index: 2;
		min-width: 9rem;
		margin-left: 12px;
		padding: 0.5rem 0.75rem;
		border-radius: 8px;
		background: var(--surface);
		box-shadow: 0 4px 16px rgba(var(--black), 16%);
		font-size: 0.7em;
		line-height: 1.5;
		white-space: nowrap;
	}
	.tooltip.flip {
		margin-left: 0;
		transform: translateX(calc(-100% - 12px));
	}
	.tooltip :global(p) {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin: 0;
		color: rgb(var(--gray));
	}
	.tooltip :global(.tooltip-title) {
		font-weight: 700;
		color: rgb(var(--gray-dark));
	}
	.tooltip :global(strong) {
		color: rgb(var(--black));
	}
	.tooltip :global(.tooltip-key) {
		display: inline-block;
		width: 0.8rem;
		height: 3px;
		border-radius: 2px;
	}
	.table-view {
		margin-top: 0.75rem;
		font-size: 0.75em;
	}
	.table-view summary {
		cursor: pointer;
		color: var(--accent);
	}
	.table-scroll {
		overflow-x: auto;
		margin-top: 0.5rem;
	}
	.table-view table {
		border-collapse: collapse;
		font-variant-numeric: tabular-nums;
	}
	.table-view th,
	.table-view td {
		padding: 0.25rem 0.75rem 0.25rem 0;
		text-align: left;
		white-space: nowrap;
	}
	@media (prefers-reduced-motion: reduce) {
		.hover-dot,
		.tooltip {
			transition: none;
		}
	}
</style>
