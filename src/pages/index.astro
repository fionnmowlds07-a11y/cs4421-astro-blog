---
export const prerender = true;
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hi, I'm Fionn</h1>
			<p>
				My name is Fionn Mowlds. I am a current student in Immersive Software Engineering (LM173) at the
				University of Limerick. As well as this, I am a devoted rower and have previously represented
				Ireland internationally.
			</p>
			<h2>On this site</h2>
			<ul>
				<li><a href="/man-united">Man United</a>: league position, results, fixtures and top scorers.</li>
				<li><a href="/rowing">Rowing</a>: my training log, with sessions, splits and personal bests.</li>
				<li><a href="/about-me">About Me</a>: posts about me, what I'm working on and where I'm headed.</li>
			</ul>
		</main>
		<Footer />
	</body>
</html>
