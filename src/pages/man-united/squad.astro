---
// The Man United squad grouped by position, with ages, nationalities and Premier League goals.
// The free football-data.org plan has no appearances or minutes, so goals are the only per-player stat.
export const prerender = false;
import { FOOTBALL_DATA_API_KEY } from 'astro:env/server';
import UpdatedNote from '../../components/UpdatedNote.astro';
import ManUnitedLayout from '../../layouts/ManUnitedLayout.astro';
import { type WithRefreshStatus } from '../../lib/football';
import { footballCacheControl } from '../../lib/football-endpoint';
import { getPremierLeagueData, type PositionGroup, type PremierLeagueData } from '../../lib/league';

let data: WithRefreshStatus<PremierLeagueData> | null = null;
if (FOOTBALL_DATA_API_KEY) {
	try {
		data = await getPremierLeagueData(FOOTBALL_DATA_API_KEY);
	} catch {
		// The /api/premier-league/summary endpoint logs upstream failures; the page just shows the fallback.
	}
}

if (data) {
	Astro.response.headers.set('Cache-Control', footballCacheControl(data.refreshFailed));
}

const squad = data?.squad ?? [];
const groupNames: Record<PositionGroup, string> = {
	Goalkeeper: 'Goalkeepers',
	Defence: 'Defenders',
	Midfield: 'Midfielders',
	Offence: 'Forwards',
	Other: 'Position not listed',
};
// squadSummary already orders players by position, so grouping keeps that order.
const groups = (Object.keys(groupNames) as PositionGroup[])
	.map((position) => ({ position, name: groupNames[position], players: squad.filter((p) => p.position === position) }))
	.filter((g) => g.players.length > 0);

const ages = squad.map((p) => p.age).filter((age) => age !== null);
const averageAge = ages.length ? (ages.reduce((sum, age) => sum + age, 0) / ages.length).toFixed(1) : null;
const nationalities = new Set(squad.map((p) => p.nationality).filter(Boolean)).size;
const scorers = squad.filter((p) => p.goals > 0).length;

---

<ManUnitedLayout title="Man United squad" heading="Squad" description="The Manchester United squad by position, with ages, nationalities and Premier League goals.">
	{
		!data || squad.length === 0 ? (
			<p class="fallback" data-testid="stats-unavailable">
				Live stats are unavailable right now. Please check back soon.
			</p>
		) : (
			<>
				<dl class="summary" data-testid="squad-summary">
					<div>
						<dt>Players</dt>
						<dd>{squad.length}</dd>
					</div>
					{averageAge && (
						<div>
							<dt>Average age</dt>
							<dd>{averageAge}</dd>
						</div>
					)}
					<div>
						<dt>Nationalities</dt>
						<dd>{nationalities}</dd>
					</div>
					<div>
						<dt>PL scorers</dt>
						<dd>{scorers}</dd>
					</div>
				</dl>

				{groups.map((group) => (
					<section class="group" aria-labelledby={`group-${group.position}`}>
						<h2 id={`group-${group.position}`}>
							{group.name} <span class="count">{group.players.length}</span>
						</h2>
						<ul class="players" data-testid="squad-group">
							{group.players.map((p) => (
								<li class="panel player">
									<p class="name">{p.name}</p>
									<p class="details">
										{[p.age !== null ? `${p.age} yrs` : null, p.nationality].filter(Boolean).join(' · ')}
									</p>
									{p.goals > 0 && (
										<p class="goals">
											<strong>{p.goals}</strong> PL {p.goals === 1 ? 'goal' : 'goals'}
										</p>
									)}
								</li>
							))}
						</ul>
					</section>
				))}

				<p class="note">
					Squad list from football-data.org. Appearances and minutes aren't available on the free plan, so goals are the
					only per-player stat.
				</p>
				<UpdatedNote updatedAt={data.updatedAt} refreshFailed={data.refreshFailed} />
			</>
		)
	}
</ManUnitedLayout>

<style>
	.summary {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 2rem;
		margin: 0 0 2rem;
		padding: 1rem 1.5rem;
		border-radius: 14px;
		background: #0a0a0a;
		color: rgba(255, 255, 255, 0.75);
	}
	.summary dt {
		font-size: 0.65em;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
	.summary dd {
		margin: 0;
		font-size: 1.5em;
		font-weight: 700;
		color: #fbe122;
	}
	.group + .group {
		margin-top: 1.75rem;
	}
	.group h2 {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 1.1em;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		margin-bottom: 0.75rem;
	}
	.count {
		padding: 0.05rem 0.5rem;
		border-radius: 999px;
		font-size: 0.75em;
		background: rgba(218, 41, 28, 10%);
		color: var(--accent-dark);
	}
	.players {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(13rem, 100%), 1fr));
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.player {
		padding: 0.9rem 1.1rem;
		border-left: 4px solid var(--accent);
	}
	.player p {
		margin: 0;
	}
	.name {
		font-weight: 700;
		color: rgb(var(--black));
		line-height: 1.3;
	}
	.details {
		font-size: 0.75em;
		color: rgb(var(--gray));
	}
	.player .goals {
		margin-top: 0.35rem;
		font-size: 0.75em;
		color: rgb(var(--gray-dark));
	}
	.goals strong {
		color: var(--accent);
	}
	@media (max-width: 600px) {
		.players {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.5rem;
		}
		.player {
			padding: 0.75rem 0.85rem;
		}
	}
</style>
