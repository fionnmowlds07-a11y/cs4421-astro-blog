---
// The rowing admin area. src/middleware.ts has already sent logged-out visitors to the login page
// and put its decision in Astro.locals.admin.
export const prerender = false;
import AdminNotice from '../../../components/rowing/AdminNotice.astro';
import RowingLayout from '../../../layouts/RowingLayout.astro';
import { adminStatus } from '../../../lib/rowing-admin';
import { formatDate, formatDistance, MACHINE_NAMES } from '../../../lib/rowing-format';
import type { ErgSessionRow, OnWaterOutingRow } from '../../../lib/rowing-forms';
import { formatTime } from '../../../lib/rowing-time';
import '../../../styles/rowing-admin.css';

const admin = Astro.locals.admin ?? { access: 'unavailable' as const };
Astro.response.status = adminStatus(admin.access);

const SAVED_MESSAGES: Record<string, string> = {
	erg: 'Erg session saved.',
	outing: 'On-water outing saved.',
};
const saved = SAVED_MESSAGES[Astro.url.searchParams.get('saved') ?? ''];

// The latest entries of each kind. A failed load only hides that list; the add buttons still work.
const LIST_SIZE = 25;
type Saved<Row> = Row & { id: string; avg_split_ds: number | null };
let ergSessions: Saved<ErgSessionRow>[] | null = null;
let outings: Saved<OnWaterOutingRow>[] | null = null;

if (admin.access === 'allow' && admin.supabase) {
	const [erg, water] = await Promise.all([
		admin.supabase
			.from('erg_sessions')
			.select('*')
			.order('session_date', { ascending: false })
			.order('created_at', { ascending: false })
			.limit(LIST_SIZE),
		admin.supabase
			.from('on_water_outings')
			.select('*')
			.order('outing_date', { ascending: false })
			.order('created_at', { ascending: false })
			.limit(LIST_SIZE),
	]);
	ergSessions = erg.error ? null : erg.data;
	outings = water.error ? null : water.data;
}

const time = (ds: number | null) => (ds === null ? '–' : formatTime(ds));
---

<RowingLayout title="Rowing admin" heading="Rowing admin" description="Manage the rowing log." noindex>
	{
		admin.access === 'allow' ? (
			<section class="panel" data-testid="admin-area">
				{saved && (
					<p class="form-message saved" role="status" data-testid="saved-message">
						{saved}
					</p>
				)}
				<p>
					Logged in as <strong>{admin.email}</strong>.
				</p>
				<div class="form-actions">
					<a class="button primary" href="/rowing/admin/erg/new">
						Add erg session
					</a>
					<a class="button primary" href="/rowing/admin/water/new">
						Add on-water outing
					</a>
				</div>
			</section>
		) : (
			<AdminNotice access={admin.access} email={admin.email} />
		)
	}
	{
		admin.access === 'allow' && (
			<>
				<h2>Erg sessions</h2>
				{ergSessions === null ? (
					<p class="form-message error" data-testid="erg-list-error">
						Couldn't load your erg sessions right now.
					</p>
				) : ergSessions.length === 0 ? (
					<p class="empty">No erg sessions yet.</p>
				) : (
					<div class="table-wrap">
						<table class="log-table" data-testid="erg-list">
							<caption class="sr-only">Latest {LIST_SIZE} erg sessions</caption>
							<thead>
								<tr>
									<th scope="col">Date</th>
									<th scope="col">Session</th>
									<th scope="col">Distance</th>
									<th scope="col">Time</th>
									<th scope="col">Split</th>
									<th scope="col">Rate</th>
									<th scope="col">Machine</th>
								</tr>
							</thead>
							<tbody>
								{ergSessions.map((s) => (
									<tr>
										<td>{formatDate(s.session_date)}</td>
										<td class="what">
											{s.description ?? (s.session_type === 'intervals' ? 'Intervals' : 'Single piece')}
											{s.is_test && <span class="tag">Test</span>}
										</td>
										<td>{formatDistance(s.distance_m)}</td>
										<td>{time(s.duration_ds)}</td>
										<td>{time(s.avg_split_ds)}</td>
										<td>{s.avg_rate ?? '–'}</td>
										<td>{MACHINE_NAMES[s.machine]}</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				)}

				<h2>On-water outings</h2>
				{outings === null ? (
					<p class="form-message error" data-testid="outing-list-error">
						Couldn't load your outings right now.
					</p>
				) : outings.length === 0 ? (
					<p class="empty">No outings yet.</p>
				) : (
					<div class="table-wrap">
						<table class="log-table" data-testid="outing-list">
							<caption class="sr-only">Latest {LIST_SIZE} on-water outings</caption>
							<thead>
								<tr>
									<th scope="col">Date</th>
									<th scope="col">Boat</th>
									<th scope="col">Crew</th>
									<th scope="col">Distance</th>
									<th scope="col">Time</th>
									<th scope="col">Split</th>
									<th scope="col">Conditions</th>
								</tr>
							</thead>
							<tbody>
								{outings.map((o) => (
									<tr>
										<td>{formatDate(o.outing_date)}</td>
										<td>{o.boat}</td>
										<td class="what">{o.crew ?? '–'}</td>
										<td>{formatDistance(o.distance_m)}</td>
										<td>{time(o.duration_ds)}</td>
										<td>{time(o.avg_split_ds)}</td>
										<td class="what">{o.conditions ?? '–'}</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				)}
			</>
		)
	}
	{
		admin.access !== 'unavailable' && (
			<form class="logout" method="post" action="/rowing/logout">
				<button class="button" type="submit">
					Log out
				</button>
			</form>
		)
	}
</RowingLayout>

<style>
	.panel {
		display: grid;
		gap: 1rem;
	}
	.panel p {
		margin: 0;
	}
	.logout {
		margin-top: 1.25rem;
	}
	h2 {
		margin: 2rem 0 0.75rem;
		font-size: 1.4em;
	}
	.empty {
		color: rgb(var(--gray));
	}
</style>
