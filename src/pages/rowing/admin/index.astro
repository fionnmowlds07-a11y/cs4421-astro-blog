---
// The rowing admin area. src/middleware.ts has already sent logged-out visitors to the login page
// and put its decision in Astro.locals.admin.
export const prerender = false;
import AdminNotice from '../../../components/rowing/AdminNotice.astro';
import RowingLayout from '../../../layouts/RowingLayout.astro';
import { adminStatus } from '../../../lib/rowing-admin';
import '../../../styles/rowing-admin.css';

const admin = Astro.locals.admin ?? { access: 'unavailable' as const };
Astro.response.status = adminStatus(admin.access);

const SAVED_MESSAGES: Record<string, string> = {
	erg: 'Erg session saved.',
	outing: 'On-water outing saved.',
};
const saved = SAVED_MESSAGES[Astro.url.searchParams.get('saved') ?? ''];
---

<RowingLayout title="Rowing admin" heading="Rowing admin" description="Manage the rowing log." noindex>
	{
		admin.access === 'allow' ? (
			<section class="panel" data-testid="admin-area">
				{saved && (
					<p class="form-message saved" role="status" data-testid="saved-message">
						{saved}
					</p>
				)}
				<p>
					Logged in as <strong>{admin.email}</strong>.
				</p>
				<div class="form-actions">
					<a class="button primary" href="/rowing/admin/erg/new">
						Add erg session
					</a>
					<a class="button primary" href="/rowing/admin/water/new">
						Add on-water outing
					</a>
				</div>
			</section>
		) : (
			<AdminNotice access={admin.access} email={admin.email} />
		)
	}
	{
		admin.access !== 'unavailable' && (
			<form class="logout" method="post" action="/rowing/logout">
				<button class="button" type="submit">
					Log out
				</button>
			</form>
		)
	}
</RowingLayout>

<style>
	.panel {
		display: grid;
		gap: 1rem;
	}
	.panel p {
		margin: 0;
	}
	.logout {
		margin-top: 1.25rem;
	}
</style>
