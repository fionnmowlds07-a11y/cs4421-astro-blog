---
// Edit or delete one erg session. ?delete shows a confirmation step first; the form there posts
// intent=delete. Changes are made as the logged-in user, so row level security has the final say.
export const prerender = false;
import AdminNotice from '../../../../components/rowing/AdminNotice.astro';
import ErgSessionForm from '../../../../components/rowing/ErgSessionForm.astro';
import RowingLayout from '../../../../layouts/RowingLayout.astro';
import { adminStatus, formValues, isRowId, saveFailure } from '../../../../lib/rowing-admin';
import { formatDate, formatDistance } from '../../../../lib/rowing-format';
import { ergSessionValues, validateErgSession, type ErgSessionRow } from '../../../../lib/rowing-forms';
import { formatTime } from '../../../../lib/rowing-time';
import '../../../../styles/rowing-admin.css';

const admin = Astro.locals.admin ?? { access: 'unavailable' as const };
Astro.response.status = adminStatus(admin.access);

const { id } = Astro.params;
const editPath = `/rowing/admin/erg/${id}`;
const confirmingDelete = Astro.url.searchParams.has('delete');
let saved: ErgSessionRow | null = null;
let values: Record<string, string> = {};
let errors: Record<string, string> = {};
let formError: string | null = null;
let notFound = false;

if (admin.access === 'allow' && admin.supabase) {
	const sessions = () => admin.supabase!.from('erg_sessions');

	if (!isRowId(id)) {
		notFound = true;
	} else if (Astro.request.method === 'POST') {
		const form = await Astro.request.formData();
		if (form.get('intent') === 'delete') {
			const { data, error } = await sessions().delete().eq('id', id).select('id');
			if (!error && data.length > 0) return Astro.redirect('/rowing/admin?deleted=erg', 303);
			if (!error) notFound = true;
			else {
				const failure = saveFailure(error);
				Astro.response.status = failure.status;
				formError = failure.message;
			}
		} else {
			values = formValues(form);
			const result = validateErgSession(form);
			if (!result.ok) {
				Astro.response.status = 422;
				errors = result.errors;
			} else {
				const { data, error } = await sessions().update(result.row.session).eq('id', id).select('id');
				if (!error && data.length > 0) return Astro.redirect('/rowing/admin?saved=erg', 303);
				if (!error) notFound = true;
				else {
					const failure = saveFailure(error);
					Astro.response.status = failure.status;
					formError = failure.message;
				}
			}
		}
	}

	// Load the session to fill the form or describe it on the confirmation step.
	if (!notFound && (Astro.request.method !== 'POST' || confirmingDelete)) {
		const { data, error } = await sessions().select('*').eq('id', id).maybeSingle();
		if (error) {
			Astro.response.status = 503;
			formError = "Couldn't load this session right now.";
		} else if (!data) {
			notFound = true;
		} else {
			saved = data;
			if (Astro.request.method !== 'POST') values = ergSessionValues(data);
		}
	}

	if (notFound) Astro.response.status = 404;
}
---

<RowingLayout
	title={confirmingDelete ? 'Delete erg session' : 'Edit erg session'}
	heading={confirmingDelete ? 'Delete erg session' : 'Edit erg session'}
	description="Change or delete an erg session."
	noindex
>
	{
		admin.access !== 'allow' ? (
			<AdminNotice access={admin.access} email={admin.email} />
		) : notFound ? (
			<p class="panel" data-testid="not-found">
				That session doesn't exist. It may already have been deleted. <a href="/rowing/admin">Back to the admin page</a>
			</p>
		) : confirmingDelete ? (
			<form class="panel admin-form" method="post" data-testid="delete-confirm">
				{formError && (
					<p class="form-message error" role="alert" data-testid="form-error">
						{formError}
					</p>
				)}
				{saved && (
					<p class="wide">
						Delete the erg session on <strong>{formatDate(saved.session_date)}</strong>
						{` (${formatDistance(saved.distance_m)} in ${formatTime(saved.duration_ds)})? This can't be undone.`}
					</p>
				)}
				<input type="hidden" name="intent" value="delete" />
				<div class="form-actions">
					<button class="button danger" type="submit">
						Yes, delete it
					</button>
					<a class="button" href={editPath}>
						Cancel
					</a>
				</div>
			</form>
		) : (
			<>
				<ErgSessionForm values={values} errors={errors} formError={formError} submitLabel="Save changes" />
				<p class="delete-link">
					<a href={`${editPath}?delete`}>Delete this session…</a>
				</p>
			</>
		)
	}
</RowingLayout>
